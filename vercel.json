{
  "rewrites": [
    {
      "source": "/~oauth/initiate",
      "destination": "https://oauth.lovable.app/initiate"
    },
    {
      "source": "/~oauth/callback",
      "destination": "https://oauth.lovable.app/callback"
    },
    {
      "source": "/~oauth/:path*",
      "destination": "https://oauth.lovable.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
