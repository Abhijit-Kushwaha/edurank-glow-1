{
  "headers": [
    {
      "source": "/(.*)\\.woff2",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/~oauth/initiate",
      "destination": "https://oauth.lovable.app/initiate?project_id=90f8581c-f8e9-4037-92ae-7fc389144b19"
    },
    {
      "source": "/~oauth/callback",
      "destination": "https://oauth.lovable.app/callback"
    },
    {
      "source": "/~oauth/:path*",
      "destination": "https://oauth.lovable.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
